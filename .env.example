# ───────────────────────────────────────────────────────────────────────
# Zasder Weather backend configuration
#
# Copy this file to .env, fill in real values, never commit .env.
# Every value can also be set via environment variable (Fly.io secrets,
# docker compose env, etc.) instead of a file.
# ───────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────

# Shared secret the iOS app sends as `Authorization: Bearer <token>`.
# Generate with:  openssl rand -hex 32
# Treat like a password — anyone with this token can read all your data.
API_TOKEN=generate-a-long-random-string

# Shared secret used by SDR relays (LilyGO) when POSTing observations
# to /ingest/custom. Distinct from API_TOKEN so revoking write doesn't
# lock the iOS app out. Required if you're running any SDR relay.
# Generate with:  openssl rand -hex 32
INGEST_TOKEN=generate-a-long-random-string

# Where SQLite lives. Fly.io: /data/weather.db (persistent volume).
# Local docker: /data/weather.db (named volume). Local dev: ./data/weather.db
DATABASE_PATH=./data/weather.db

# Comma-separated hostnames the backend will accept (Host-header allowlist,
# via TrustedHostMiddleware). Defaults to "*" (accept any). Recommended in
# production — set it to your real host(s) to reject spoofed Host headers,
# e.g. ALLOWED_HOSTS=weather.example.com,*.fly.dev
# ALLOWED_HOSTS=*

# Debug mode. false by default. Any truthy value (1/true/yes) enables the
# interactive API docs at /docs, /redoc, /openapi.json. Leave off in production.
# DEBUG=false

# ── Path A: AmbientWeather cloud poller (optional) ───────────────────
# Set both to enable. Get them from https://ambientweather.net/account.
# Leave unset to skip the AWN poller — it stays asleep silently.
# AW_APPLICATION_KEY=replace-with-application-key
# AW_API_KEY=replace-with-api-key
# AWN rate-limits at 1 req/sec per Application Key. 60s is comfortable.
POLL_INTERVAL_SECONDS=60

# ── Path B: Davis WeatherLink cloud poller (optional) ────────────────
# All three required together to enable. Generate the key + secret at
# https://www.weatherlink.com/account (scroll to "API Key v2" at the
# bottom — Davis intentionally tucks it below the fold).
# Then call /v2/stations once with curl to find your station_id.
# Leave any unset to skip the WeatherLink poller.
# WEATHERLINK_API_KEY=
# WEATHERLINK_API_SECRET=
# WEATHERLINK_STATION_ID=
# WEATHERLINK_NAME=Davis Vantage Pro2 (Cloud)
# WEATHERLINK_LOCATION=Your City
# Poll cadence in seconds. Free tier = 5min data so poll every 300s; Pro+
# = 1min data so 30s is plenty. Floor is 15s.
# WEATHERLINK_POLL_INTERVAL_SECONDS=60
# If your Davis ISS was installed mid-year, the cloud reports yearly
# rain only since pairing. Set the actual prior year-to-date here and
# the poller adds it to every reading so the rollup is real.
# WEATHERLINK_YEARLY_RAIN_BASELINE_IN=0

# ── Path E: Davis WeatherLink LIVE (LAN local poller) ────────────────
# Same Davis hardware as Path B, but polled locally over your LAN — no
# API key, no cloud round-trip, ~6× fresher data. Backend needs NO env
# vars for this path; you just POST to /ingest/custom from a Pi-side
# poller. Configure the poller (WLL_HOST, INGEST_TOKEN, etc.) in
# wll-poller/.env on the Pi — see wll-poller/README.md.
#
# Rain: the poller sends cumulative counters and the backend computes
# daily/period rain from stored deltas — no calibration needed (same as
# the LilyGO paths).

# ── Path C/D: LilyGO ESP32 SDR direct ────────────────────────────────
# The boards themselves are provisioned with backend_url + ingest_token
# via the captive portal (see lilygo-relay/README.md). No backend env
# vars are needed. Lifetime rain counters pass through RAW and
# daily/period rain is computed from stored deltas, so no calibration
# is required. (INGEST_YEARLY_RAIN_OFFSETS existed before v1.3.2 and is
# now inert — remove it from old configs.)
#
# Rain-glitch guard. Applies to ALL /ingest/custom posts (SDR/LilyGO and any
# custom relay) — NOT the built-in AWN/WeatherLink cloud pollers, which don't
# go through /ingest. A single reading whose cumulative yearly rain jumps more
# than this rate (in/hr) × elapsed-time (+ a 0.25" floor for tip jitter) is
# dropped — and ALL rain buckets are nulled for that one reading — since real
# rain ramps gradually while a decode glitch spikes once. 2 in/hr is well
# above any real rainfall. Set 0 to disable.
# INGEST_MAX_RAIN_RATE_IN_PER_HR=2.0
#
# Wind-gust glitch guard (also all /ingest/custom sources). A gust above
# INGEST_GUST_MIN_MPH that ALSO exceeds INGEST_GUST_MAX_FACTOR × the
# concurrent sustained wind is dropped (windgustmph nulled for that one
# reading) — a 58 mph "gust" beside a 4 mph sustained wind is a decode
# glitch, and keeping it fires false high-wind alerts and pollutes the
# peak-gust record. Real gusts (desert microbursts included) ride on real
# sustained wind and stay under these bounds. INGEST_GUST_MAX_FACTOR=0
# disables the guard.
# INGEST_GUST_MAX_FACTOR=4.0
# INGEST_GUST_MIN_MPH=30.0
#
# History-write throttle (seconds) for high-cadence sources — a 10s SDR
# relay writes mostly near-duplicate rows, the main driver of unbounded DB
# growth. When > 0, a reading arriving within N seconds of the last STORED
# row for the same device is not written to history — UNLESS it carries a
# field the last row was missing (multi-source composite posts are never
# dropped). The live view still updates on every post; only stored-history
# resolution is coarsened (charts bucket anyway). 0 = store every reading.
# INGEST_MIN_INTERVAL_SECONDS=0
#
# Elevation-based sea-level pressure correction (opt-in). Some SDR-decoded
# sensors (e.g. a Fineoffset WH32B) post ABSOLUTE station pressure, which
# reads low at altitude (~1.2 inHg at 1200 ft) next to the sea-level-relative
# values AWN/Davis report. Set your station's elevation in feet and list the
# MAC(s) of the absolute-pressure devices (comma-separated, colonized or
# compact); their readings are converted absolute → sea-level at ingest via
# the standard-atmosphere formula. Physics from your real elevation — not a
# hand-tuned offset. Leave elevation at 0 (default) to disable.
# STATION_ELEVATION_FT=1200
# PRESSURE_ABSOLUTE_MACS=5D:5D:02:00:00:7D

# ── Optional: device-down email alerts ──────────────────────────────
# Email you when a device that was reporting goes quiet (an SDR board
# hangs, a sensor battery dies, a cloud API key expires). Disabled unless
# ALERT_EMAIL_TO and SMTP_HOST are both set. The monitor watches ALL
# devices and is transition-based (baselines on first sight, alerts on
# OK→stale, sends a recovery note on stale→OK).
#
# SMTP transport — set these as SECRETS (they hold a password). Easiest:
# a Gmail account with an App Password (Google account → Security →
# 2-Step Verification → App passwords). Any SMTP provider works.
# ALERT_EMAIL_TO=you@example.com           # comma-separated for multiple
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587                            # 587 STARTTLS (default) or 465 SSL
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# ALERT_EMAIL_FROM=you@gmail.com           # defaults to SMTP_USERNAME
# SMTP_SSL=false                           # set true (and PORT=465) for implicit TLS
#
# Thresholds (minutes offline before alerting). SDR boards post every
# ~16s so 10 min catches a hang fast; a 5-min-cadence Davis cloud feed
# wants more slack — override per-MAC. Set a MAC to 0 to stop watching it.
# ALERT_STALE_MINUTES=15
# ALERT_STALE_MINUTES_BY_MAC={"5D:5D:02:00:00:7D":10,"5D:5D:05:00:00:01":20}
# ALERT_CHECK_INTERVAL_SECONDS=60
# ALERT_REPEAT_HOURS=0                      # >0 = re-remind every N h while still down

# ── Optional: push notifications ─────────────────────────────────────
# Alerts (device-down + threshold) can also be delivered as iOS push, not
# just email. There are two ways to enable it — pick ONE, or leave both
# unset to use email only (push needs an Apple Developer account; email
# does not).
#
# (1) Your OWN APNs key — if you build & ship your own iOS app under your
#     own Apple Developer account. Create an "Apple Push Notifications
#     service (APNs)" Auth Key in the Developer portal → Keys. Set these as
#     SECRETS (KEY_P8 holds the .p8 file's contents). ENV is "sandbox" for
#     dev/TestFlight builds, "production" for the App Store.
# APNS_KEY_ID=ABCD123456
# APNS_TEAM_ID=YOURTEAMID
# APNS_KEY_P8="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# APNS_TOPIC=com.yourorg.yourapp
# APNS_ENV=production
#
# (2) A hosted relay — if you use the official Zasder Weather app (App
#     Store) with your own backend. You can't hold Apple's key for that
#     app, so this backend forwards alerts to a relay that does. Get a
#     relay token from the app (Settings → Notifications → enable push);
#     it configures these for you. No Apple account needed on your side.
# APNS_RELAY_URL=https://weather.zasder.com/api/relay/push
# APNS_RELAY_TOKEN=
#
# Android push (FCM): if you ship your own Android app with your own Firebase
# project, paste the service-account key JSON here (as one secret value;
# project_id is read from it). The backend delivers to Android via FCM and
# iOS via APNs in parallel. Unset ⇒ Android push is a no-op.
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
#   (or point at a mounted file:)
# FCM_SERVICE_ACCOUNT_FILE=/data/fcm-service-account.json

# ── Optional: App Store reviewer / token rotation ────────────────────
# Secondary bearer token also accepted by /api/*. Use for App Store
# reviewer credentials (revoke after approval) or no-downtime rotation.
# REVIEWER_API_TOKEN=

# ── Optional: cross-device pressure sharing ─────────────────────────
# If a barometer-less device (e.g. an outdoor-only Atlas) is co-located
# with a device that has one (Davis cloud, a WH32B-paired Fineoffset),
# fill the missing pressure tile from the named source MAC. Single-
# location only — leave unset if you have multiple distinct sites.
# SHARED_BAROMETER_SOURCE_MAC=

# ── Optional: forecast + timezone ────────────────────────────────────
# Forecast coordinates for the iOS Forecast strip. If unset, auto-
# derived from your station's reported lat/lon.
# FORECAST_LAT=33.3004
# FORECAST_LON=-111.9379

# IANA timezone for local-time bucketing of rain rollups (daily/hourly/
# weekly/monthly). Defaults to UTC. Set to your zone so "today's rain"
# rolls over at your wall-clock midnight.
#   America/Phoenix  America/New_York  America/Los_Angeles  Europe/London
# TIMEZONE=America/Phoenix

# ── Update check ────────────────────────────────────────────────────────
# Once a day the backend asks GitHub for the latest release and shows an
# "update available" banner on the status page + at GET /api/version. It's a
# single unauthenticated public-release lookup — nothing about your instance
# or data is sent. Set to 0 to disable entirely.
# UPDATE_CHECK=1
# Point the check at a fork if you maintain your own:
# UPDATE_CHECK_REPO=volneydouglas/zasder-weather-backend

# ── Optional: public dashboard on the status page ───────────────────────
# By default the status page (/) shows app screenshots. Turn this on to
# replace them with a live, read-only dashboard of your station: current
# conditions + inline 24-hour charts, plus a link to the iOS app. Fully
# server-rendered (no client JS, no public data API — the /api/* endpoints
# stay token-gated; only the pre-rendered numbers/charts are exposed).
# Handy if you want a public "here's my weather" page. Off by default.
# PUBLIC_DASHBOARD=0
#
# Which station(s) to show. Unset = your primary (first) device only.
# "all" = every visible device. Or a comma-separated MAC allowlist
# (colonized or compact form), e.g. PUBLIC_DASHBOARD_MACS=5D:5D:05:00:00:01
# PUBLIC_DASHBOARD_MACS=
#
# Which metrics to chart, comma-separated. Unset = the core set
# (tempf,humidity,windspeedmph,baromrelin,hourlyrainin). Choose any of
# those five keys; order here is the order on the page.
# PUBLIC_DASHBOARD_FIELDS=tempf,humidity,windspeedmph,baromrelin,hourlyrainin
#
# The "Get the iOS app" link target. Defaults to the App Store listing;
# override if you ship your own app.
# PUBLIC_DASHBOARD_APP_URL=https://apps.apple.com/us/app/zasder-weather/id6774523656

# ── Optional: smart (derived) alerts ────────────────────────────────────
# Weather-intelligent alerts that need no per-metric threshold config, sent
# over the same email/push channels as the alerts above. Off by default.
# Fires once when the condition starts and re-arms when it clears.
#   * frost/freeze risk   — outdoor temp at/below SMART_ALERT_FROST_F
#   * dangerous heat      — feels-like at/above SMART_ALERT_HEAT_F
#   * rapid pressure drop — barometer falls > SMART_ALERT_PRESSURE_DROP_INHG
#                           over 3 hours (a storm may be approaching)
# SMART_ALERTS=0
# SMART_ALERT_FROST_F=35
# SMART_ALERT_HEAT_F=105
# SMART_ALERT_PRESSURE_DROP_INHG=0.06

# ── Optional: Weather Underground key (forecast + history import) ──────
# PWS-owner API key — free if your station uploads to Weather Underground
# (wunderground.com/member/api-keys). Two uses: the TWC forecast source,
# and the fallback key for POST /api/import/wu (backfill history from your
# WU station into this backend). The iOS app can also store one at runtime
# via PUT /api/config/wu-key — the app-stored key wins over this env var,
# and GET /api/config/wu-key reports which is in effect (never the value).
# WU_API_KEY=

# ── Optional: Insights (server-side statistics) ─────────────────────────
# Opt-in statistics rollups (long-term context for your readings) kept up
# to date at ingest and served at GET /api/insights?mac=… Gates BOTH the
# rollup maintenance and the endpoint (404 when off). Enabling on a
# backend with existing history needs a one-time POST /api/insights/rebuild
# to backfill the rollup tables. Off by default.
# INSIGHTS=0

# ── Optional: Prometheus metrics ────────────────────────────────────────
# Exposes GET /metrics in Prometheus text format (every device's latest
# reading as gauges) so you can scrape it into Prometheus/Grafana for
# dashboards + alerting. Open when enabled (same data class as the public
# dashboard). Off by default (404).
# PROMETHEUS_METRICS=0

# ── Optional: MQTT + Home Assistant ─────────────────────────────────────
# Set MQTT_HOST to publish each reading to your MQTT broker. Retained Home
# Assistant discovery configs make every sensor appear in HA automatically
# with the right units/device-classes; state is published to
# <MQTT_TOPIC_PREFIX>/<node>/state every ~30s.
# MQTT_HOST=192.168.1.10
# MQTT_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_TOPIC_PREFIX=zasder
# MQTT_DISCOVERY_PREFIX=homeassistant

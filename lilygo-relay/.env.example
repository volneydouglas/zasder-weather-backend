# lilygo-relay takes no .env — this file is reference only.
#
# Provisioning is two-step (see README "First-boot provisioning"):
#   1. The captive portal ("ZasderLilyGO" AP, WPA2 password
#      "zasder-setup") asks for your Wi-Fi credentials ONLY.
#   2. Once the board is on your LAN, POST the two values below to its
#      /provision endpoint, authorized with the per-device setup key
#      shown on the board's OLED / serial log:
#
#        curl -X POST http://zasder-lilygo-XXXX.local/provision \
#          -H "X-Setup-Key: $SETUP_KEY" \
#          --data-urlencode "backend_url=$BACKEND_URL" \
#          --data-urlencode "ingest_token=$INGEST_TOKEN"

# Base URL of your Zasder Weather backend (https://, no trailing slash —
# the firmware rejects plain-http URLs unless built with TLS_INSECURE).
BACKEND_URL=https://weather.example.com

# Bearer token the backend accepts on /ingest/custom. Must match the
# backend's INGEST_TOKEN secret. Generate with `openssl rand -hex 32`.
INGEST_TOKEN=replace-with-the-backend-ingest-token
